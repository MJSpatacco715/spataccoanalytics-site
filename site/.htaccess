# Managed in the repository (site/.htaccess). A change made on the host is
# overwritten on the next publish.

DirectoryIndex index.html index.php

# Pages are served fresh. The host keeps a copy of every page it serves, and
# after a publish it went on handing out the old copy until someone cleared it
# by hand. Marked this way the host does not keep pages at all and a browser
# checks before it reuses one. Scripts, styles and images keep their long
# life: where one changes, its address carries a version.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "private, no-cache"
  </FilesMatch>
</IfModule>

RewriteEngine On

# One address: www goes to the bare domain.
RewriteCond %{HTTP_HOST} ^www\.spataccoanalytics\.com$ [NC]
RewriteRule ^ https://spataccoanalytics.com%{REQUEST_URI} [R=301,L]

# The earlier site's pages are still on the host. Each goes to the page that
# replaced it, so search engines stop listing the old copies.
RewriteCond %{THE_REQUEST} \s/index\.php[\s?]
RewriteRule ^index\.php$ https://spataccoanalytics.com/ [R=301,L]
RewriteRule ^services\.php$ https://spataccoanalytics.com/services/ [R=301,L]
RewriteRule ^contact\.php$ https://spataccoanalytics.com/contact/ [R=301,L]
RewriteRule ^about\.php$ https://spataccoanalytics.com/#about [R=301,NE,QSD,L]
RewriteRule ^approach\.php$ https://spataccoanalytics.com/#approach [R=301,NE,QSD,L]
# the resume parser has one address
RewriteRule ^tools/resume-parser\.html$ https://spataccoanalytics.com/tools/resume-parser/ [R=301,L]

RewriteRule ^_(header|footer)\.php$ https://spataccoanalytics.com/ [R=301,L]
